
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Debate Room AI</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  background: #0f172a;
  color: white;
  height: 100vh;
}

.chat-container {
  max-width: 900px;
  height: 100vh;
  margin: auto;
  display: flex;
  flex-direction: column;
  background: #111827;
}

.header {
  padding: 20px;
  border-bottom: 1px solid #334155;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header h2 {
  color: #38bdf8;
}

.header button {
  padding: 9px 14px;
  background: #334155;
  color: white;
  border: none;
  border-radius: 8px;
  cursor: pointer;
}

.messages {
  flex: 1;
  overflow-y: auto;
  padding: 25px;
}

.message {
  max-width: 80%;
  padding: 14px 17px;
  margin-bottom: 18px;
  border-radius: 14px;
  line-height: 1.6;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.user {
  background: #2563eb;
  margin-left: auto;
}

.ai {
  background: #263449;
  margin-right: auto;
}

.welcome {
  text-align: center;
  margin-top: 100px;
  color: #cbd5e1;
}

.welcome h1 {
  font-size: 30px;
  margin-bottom: 12px;
}

.input-area {
  padding: 18px;
  display: flex;
  gap: 10px;
  border-top: 1px solid #334155;
}

.input-area textarea {
  flex: 1;
  padding: 14px;
  border-radius: 12px;
  border: 1px solid #475569;
  background: #1e293b;
  color: white;
  resize: none;
  outline: none;
  font-size: 15px;
}

.input-area button {
  padding: 0 22px;
  background: #0284c7;
  color: white;
  border: none;
  border-radius: 12px;
  cursor: pointer;
  font-size: 16px;
}

.input-area button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.typing {
  color: #94a3b8;
  padding: 10px;
}

@media(max-width:600px) {
  .message { max-width: 95%; }
  .welcome h1 { font-size: 23px; }
}
</style>
</head>

<body>

<div class="chat-container">

  <div class="header">
    <h2>✦ Debate Room AI</h2>
    <button onclick="newChat()">New Chat</button>
  </div>

  <div class="messages" id="messages">
    <div class="welcome" id="welcome">
      <h1>How can I help you today?</h1>
      <p>Ask anything. Explore ideas. Prepare for debates.</p>
    </div>
  </div>

  <div class="input-area">
    <textarea
      id="userInput"
      rows="1"
      placeholder="Ask anything..."
      onkeydown="handleKey(event)"
    ></textarea>

    <button id="sendBtn" onclick="sendMessage()">Send ➤</button>
  </div>

</div>

<script>
const messages = document.getElementById("messages");
const input = document.getElementById("userInput");
const sendBtn = document.getElementById("sendBtn");

let chatHistory = [];
let loading = false;

function addMessage(text, type) {
  document.getElementById("welcome")?.remove();

  const div = document.createElement("div");
  div.className = "message " + type;
  div.textContent = text;

  messages.appendChild(div);
  messages.scrollTop = messages.scrollHeight;

  return div;
}

async function sendMessage() {
  const text = input.value.trim();

  if (!text || loading) return;

  addMessage(text, "user");

  chatHistory.push({
    role: "user",
    content: text
  });

  input.value = "";
  loading = true;
  sendBtn.disabled = true;

  const typing = addMessage("AI is thinking...", "typing");

  try {
    const response = await fetch("/api/ai/chat", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Authorization": "Bearer " + localStorage.getItem("token")
      },
      body: JSON.stringify({
        message: text,
        history: chatHistory.slice(0, -1)
      })
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.message || "Something went wrong");
    }

    typing.remove();

    const reply = data.reply || "No response received.";

    addMessage(reply, "ai");

    chatHistory.push({
      role: "assistant",
      content: reply
    });

  } catch (error) {
    typing.textContent = "Error: " + error.message;
    chatHistory.pop();
  }

  loading = false;
  sendBtn.disabled = false;
  input.focus();
}

function handleKey(event) {
  if (event.key === "Enter" && !event.shiftKey) {
    event.preventDefault();
    sendMessage();
  }
}

function newChat() {
  chatHistory = [];
  messages.innerHTML = `
    <div class="welcome" id="welcome">
      <h1>How can I help you today?</h1>
      <p>Ask anything. Explore ideas. Prepare for debates.</p>
    </div>
  `;
}
</script>

</body>
</html>
